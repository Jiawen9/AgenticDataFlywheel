# Copy this file to backend/.env and fill in the endpoint used by your
# approved internal model gateway.  There is intentionally no external URL
# fallback in the application.
#
# Common model connection settings.  Every model-using module inherits these
# unless its module-specific override below is set.
MODEL_API_KEY=your_api_key_here
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
MODEL_VERIFY_TLS=true
MODEL_HTTP_PROXY=
MODEL_TRUST_ENV=false

# Module-specific model names.  The endpoint/key can also be overridden with
# TREE_BASE_URL/TREE_API_KEY, QUALITY_BASE_URL/QUALITY_API_KEY, etc.
TREE_MODEL=qwen3.6-27b:floor
BBOX_MODEL=qwen3.6-27b:floor
QUALITY_MODEL=qwen3.6-27b:floor
TASK_GENERATION_MODEL=Qwen3-VL-32B-Instruct
# Examples of optional per-module connection overrides:
# TREE_BASE_URL=http://tree-model-gateway/v1
# QUALITY_BASE_URL=http://quality-model-gateway/v1
# TASK_GENERATION_BASE_URL=http://task-model-gateway/v1
# TASK_GENERATION_API_KEY=another_key

# Optional task-generation data/configuration settings. The default is
# backend_workspace/task_generation/KnowledgeBase.
TASK_GENERATION_KNOWLEDGE_BASE_DIR=
TASK_GENERATION_MAX_CONCURRENT=16

# Compatibility with older checkouts.  New deployments should use the
# MODEL_* and <MODULE>_* names above instead.
# YUNAI_API_KEY=your_api_key_here
# MODEL_URL=http://127.0.0.1:8000/v1
# MODEL_NAME=qwen3.6-27b:floor

# Python 3.10+ executable used by background AdaRubric quality jobs.
ADARUBRIC_PYTHON=D:\anaconda3\envs\guigent\python.exe
