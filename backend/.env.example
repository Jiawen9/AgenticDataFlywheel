# Copy this file to backend/.env and replace the placeholder API key.
YUNAI_API_KEY=your_api_key_here
MODEL_URL=https://yunai.chat/v1
MODEL_NAME=qwen3.6-27b:floor
# Vision-language model used only for corrected-step COT generation.
COT_MODEL_NAME=qwen3-vl-32b-instruct
# Python 3.10+ executable used by background AdaRubric quality jobs.
ADARUBRIC_PYTHON=D:\anaconda3\envs\guigent\python.exe
# Maximum concurrent independent model calls during tree construction.
TREE_CLASSIFICATION_MAX_CONCURRENT=4
# Maximum concurrent final-answer summaries during tree construction.
TREE_SUMMARY_MAX_CONCURRENT=2
# Maximum concurrent trajectory evaluations during quality inspection.
ADARUBRIC_EVAL_MAX_CONCURRENT=2
# Optional task-generation overrides; shared MODEL_* values are used by default.
# TASK_GENERATION_API_KEY=your_task_generation_api_key
# TASK_GENERATION_MODEL_URL=https://yunai.chat/v1
# TASK_GENERATION_MODEL_NAME=qwen3.6-27b:floor
# TASK_GENERATION_HTTP_PROXY_URL=
# TASK_GENERATION_HTTP_VERIFY=true
# TASK_GENERATION_HTTP_TIMEOUT=120
# TASK_GENERATION_HTTP_TRUST_ENV=false
# TASK_GENERATION_MAX_RETRIES=2
TASK_GENERATION_MAX_CONCURRENT=4
# 输出预算；推理型模型可能需要更大的预算。不会自动修改你的本地 .env。
# TASK_GENERATION_GENERATION_MAX_TOKENS=8192
# TASK_GENERATION_CLASSIFICATION_MAX_TOKENS=2048
# 校验失败/数量不足时最多额外请求次数（独立于网络重试，0 表示不补生成）
# TASK_GENERATION_VALIDATION_RETRIES=1
# 仅在供应商确认支持时开启 JSON object 模式；默认不发送 response_format
# TASK_GENERATION_JSON_MODE=false
# 供应商专用参数，默认为 {}；不再默认发送 top_k=500
# TASK_GENERATION_EXTRA_BODY={}
# 如供应商明确支持，可自行设为 {"enable_thinking":false}，不同供应商格式可能不同
# TASK_GENERATION_TRACE_ENABLED=true

# Dataset publishing currently uses a local progress simulator. These values
# define the S3-compatible destination shown after a successful mock upload.
DATASET_UPLOAD_MODE=mock
DATASET_S3_BUCKET=training-data
DATASET_S3_PREFIX=gui-agent-datasets
