# Local configuration and secrets
.env
.env.*
!.env.example
!**/.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Node / Vue
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Runtime data generated by the phone factory dev middleware
frontend/data/

# Runtime logs and generated data
*.log
*.xlsx
backend/bounding_box/*cache*.json
backend/trajectories_tree/*cache*.json

# The workspace is local-only. Keep only its empty directory structure.
backend_workspace/*
!backend_workspace/.gitkeep
!backend_workspace/rollout_trajectories/
backend_workspace/rollout_trajectories/*
!backend_workspace/rollout_trajectories/.gitkeep
!backend_workspace/trajectory_correction/
